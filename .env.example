# Gemini API Key (Required for AI services in HealBot, Hospital Search, and Report Analyzer)
# Set this in Vercel Project Settings -> Environment Variables, or in your local .env file
GEMINI_API_KEY=

# Optional Client-side fallback for static deployments
VITE_GEMINI_API_KEY=

# Email Configuration (SMTP for Appointment Confirmation & Reminders)
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

